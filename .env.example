HOST=127.0.0.1
PORT=3000
CLIENT_URL=http://localhost:5173,http://127.0.0.1:5173
MAX_CONCURRENT_DOWNLOADS=3
MAX_QUEUE_SIZE=30
TEMP_FILE_TTL_MINUTES=30
MAX_VIDEO_DURATION_SECONDS=7200
MAX_BATCH_URLS=10
MAX_FILE_SIZE_MB=1024
PROCESS_TIMEOUT_SECONDS=900
INFO_TIMEOUT_SECONDS=90
PROFILE_TIMEOUT_SECONDS=30
PROFILE_ITEMS=8
INFO_RATE_LIMIT=30
PROFILE_RATE_LIMIT=20
DOWNLOAD_RATE_LIMIT=10
RATE_WINDOW_MINUTES=10
YT_DLP_PATH=yt-dlp
FFMPEG_PATH=ffmpeg
# Optional: bgutil provider server directory. Leave blank on Windows.
BGUTIL_SERVER_HOME=
# Optional: replace the public TikTok profile adapter with your own service.
TIKTOK_PROFILE_API_URL=https://tuantuprov.eu.org/api/other/tiktok_api.php
